<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive icon foreground — 108×108dp canvas, safe zone 72×72dp centred.
    Shows a simplified Aviator Chrono dial: silver bezel, orange 12 o'clock
    triangle, cream hands at 10:10, orange second hand at 35s.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Silver bezel ring (stroke on r=40 circle) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#B0BED0"
        android:strokeWidth="4"
        android:pathData="M54,14 A40,40 0 1,0 54.001,14 Z"/>

    <!-- Dark navy dial face (r=37) -->
    <path
        android:fillColor="#0D1840"
        android:pathData="M54,17 A37,37 0 1,0 54.001,17 Z"/>

    <!-- Major ticks at 3, 6, 9 o'clock -->
    <path android:strokeColor="#B0BED0" android:strokeWidth="3"
          android:strokeLineCap="round"
          android:pathData="M88,54 L93,54"/>
    <path android:strokeColor="#B0BED0" android:strokeWidth="3"
          android:strokeLineCap="round"
          android:pathData="M54,88 L54,93"/>
    <path android:strokeColor="#B0BED0" android:strokeWidth="3"
          android:strokeLineCap="round"
          android:pathData="M15,54 L20,54"/>

    <!-- Orange aviation triangle at 12 o'clock -->
    <path
        android:fillColor="#FF6B1A"
        android:pathData="M54,20 L50,28 L58,28 Z"/>

    <!-- Chrono sweep hand (orange, thin, 210° = ~7 o'clock) -->
    <group android:rotation="210" android:pivotX="54" android:pivotY="54">
        <path android:strokeColor="#FF6B1A" android:strokeWidth="1.5"
              android:strokeLineCap="round"
              android:pathData="M54,54 L54,22"/>
    </group>

    <!-- Minute hand (cream, 60° = 10 minutes) -->
    <group android:rotation="60" android:pivotX="54" android:pivotY="54">
        <path android:strokeColor="#D0D8E4" android:strokeWidth="3"
              android:strokeLineCap="round"
              android:pathData="M54,54 L54,21"/>
    </group>

    <!-- Hour hand (cream, 305° = 10:10) -->
    <group android:rotation="305" android:pivotX="54" android:pivotY="54">
        <path android:strokeColor="#D0D8E4" android:strokeWidth="5"
              android:strokeLineCap="round"
              android:pathData="M54,54 L54,35"/>
    </group>

    <!-- Centre hub (silver circle) -->
    <path
        android:fillColor="#D0D8E4"
        android:pathData="M54,49 A5,5 0 1,0 54.001,49 Z"/>
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M54,52 A2,2 0 1,0 54.001,52 Z"/>

</vector>
